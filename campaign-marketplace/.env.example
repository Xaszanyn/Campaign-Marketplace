# Copy this file to .env before running `docker compose up` or `pnpm dev`.
# These defaults work out of the box for local/dev use.

POSTGRES_USER=wayv_service
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=campaign_marketplace

# Host-side port Postgres is published on (used when connecting from your
# machine, e.g. `pnpm dev` without Docker, or `drizzle-kit studio`).
POSTGRES_PORT=5432

# Secret used to sign the dev session cookie. Any random string works.
SESSION_SECRET=dev-only-insecure-secret-change-me
